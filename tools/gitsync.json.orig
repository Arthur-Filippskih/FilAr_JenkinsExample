{
  "$schema": "https://raw.githubusercontent.com/Kyrales/vanessa-usher_mod/refs/heads/my_dev/resources/schema.json",
  "agent": "gitsync",
  "v8Version": "8.3.27.1786",
  "defaultInfobase": {
    "connectionString": "C:/JenkinsAgent/projects/BaseDemoUP/DemoUP_clear"
    "auth": ""
  },
  "stages": {
    "gitsync": true
  },
  "gitsync" : {
    "timeout" : 60,
    "configPath" : "./tools/gitsync_conf.json",
    "auth" : "",
    "useTemporaryInfobase" : false,
    "tempPath" : ""
  }
}
